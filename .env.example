# Local development: copy to .env. Existing process variables take precedence.
# Configure at least one text provider. Model IDs can also be edited in the UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# An OpenAI Chat Completions-compatible server (optional). Include /v1.
# HTTPS is required except for localhost/127.0.0.1/::1.
# Example local Ollama: http://127.0.0.1:11434/v1
# Ollama handles text here; it is not the audio transcription provider.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# Optional audio transcription; independent of your text provider.
# Empty BASE_URL uses https://api.openai.com/v1 and OPENAI_API_KEY as fallback.
# Custom endpoints use only TRANSCRIPTION_API_KEY (no implicit key forwarding).
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Required on Vercel and when NODE_ENV=production. Also supported locally.
# Create a long random secret; enter it in the app's access-token field.
# This is an app access token, never a provider API key.
SCRIBE_ACCESS_TOKEN=
PORT=3000
