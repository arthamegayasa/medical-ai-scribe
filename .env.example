# Server-key mode (optional). The hosted app also works with each user's own keys entered in the
# browser (BYOK); those keys go straight from the browser to the provider and never reach this server.
# Local development: copy to .env. Existing process variables take precedence.

# Text providers for SOAP generation and speaker labelling. Configure any you want to offer.
# *_MODEL is the default; users can pick another model ID in the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# An OpenAI Chat Completions-compatible server (optional). Include /v1.
# HTTPS is required except for localhost/127.0.0.1/[::1]. Example local Ollama: http://127.0.0.1:11434/v1
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=

# Audio transcription (optional), independent of the text provider.
# TRANSCRIPTION_PROVIDER: openai (default), groq, mistral, gemini, deepgram or elevenlabs.
# The key is TRANSCRIPTION_API_KEY, or else that provider's key variable above
# (DEEPGRAM_API_KEY / ELEVENLABS_API_KEY for those two).
# TRANSCRIPTION_BASE_URL selects a custom OpenAI-compatible /audio/transcriptions server instead;
# it uses only TRANSCRIPTION_API_KEY (no implicit key forwarding).
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Required on Vercel and when NODE_ENV=production for the server-key /api endpoints.
# Create a long random secret; users enter it in the app. It is an app access token, never a
# provider key. Browser BYOK mode does not use it.
SCRIBE_ACCESS_TOKEN=
PORT=3000
