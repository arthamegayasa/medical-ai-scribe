{
  "name": "Medical AI Scribe",
  "short_name": "Scribe",
  "description": "Open-source SOAP note drafts from consultations, for clinician review. Bring your own AI model.",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6f5",
